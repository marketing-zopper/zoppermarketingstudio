# Copy to .env.local for local development. Never commit real values.
# In production set these in Vercel -> Project Settings -> Environment Variables.

# Any random string of 32+ characters (signs login sessions). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Google sign-in (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pin the public URL used for the OAuth redirect, e.g. https://zoppermarketingstudio.vercel.app
APP_URL=

# Persistent database (Upstash Redis). Added automatically when you connect the
# Upstash Redis integration to the Vercel project. Leave empty locally to use .data/db.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are also accepted)
